# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development, and set the same values in your
# hosting provider's environment settings for production.
#
# Check /api/health after deploying — it reports which of these are missing.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------

# Canonical site origin, no trailing slash.
# Used for canonical URLs, Open Graph tags, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com


# --- Lead storage ----------------------------------------------------------

# SQLite file holding captured leads. Relative paths resolve from the project
# root. The directory is created automatically.
#
# ⚠️ On hosts with an ephemeral filesystem (Vercel, Netlify functions) this file
# is wiped between invocations. There, implement the LeadStore interface in
# src/server/leads/store.ts against Postgres and point it at a managed database.
# On a VPS or container, mount a persistent volume and back this file up.
LEADS_DB_PATH=.data/leads.db


# --- Lead notification -----------------------------------------------------
# Configure at least one channel, or leads are stored with nobody told about
# them. Both can run at once; each is attempted independently.

# Channel 1 — webhook. Anything that accepts a JSON POST: Zapier, Make, n8n, or
# a CRM intake endpoint (ServiceTitan, Housecall Pro, Jobber).
# Payload: { id, receivedAt, name, phone, email, zip, service, serviceSlug,
#            urgency, message, source }
SERVICE_REQUEST_WEBHOOK_URL=

# Channel 2 — email via Resend (https://resend.com). NOTIFY_TO_EMAIL accepts a
# comma-separated list. The sending domain must be verified with Resend first.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
NOTIFY_TO_EMAIL=


# --- Admin API -------------------------------------------------------------

# Bearer token for GET/PATCH /api/admin/leads. Leave empty and those endpoints
# refuse every request, so an unconfigured deploy is closed rather than open.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=


# --- Admin panel -----------------------------------------------------------
# The browser panel at /admin, where services, team, FAQs, areas and leads are
# managed. Generate all three with:  npm run admin:setup
#
# Without ADMIN_PASSWORD_HASH the login form refuses every attempt, so an
# unconfigured deploy is closed rather than open.

ADMIN_USERNAME=admin

# scrypt hash of the password, as `salt:hash`. The password itself is never
# stored. Forgot it? Run `npm run admin:setup` again to set a new one.
ADMIN_PASSWORD_HASH=

# Signs the session cookie. Changing it logs everyone out immediately, which is
# also how you revoke a session you no longer trust.
ADMIN_SESSION_SECRET=


# --- Privacy ---------------------------------------------------------------

# Salt used to hash visitor IP addresses before storing them (raw IPs are never
# written to the database). Set this so hashes stay stable across restarts;
# without it a random per-process salt is used and rate-limit history resets.
# Generate one the same way as ADMIN_API_TOKEN.
IP_HASH_SALT=
