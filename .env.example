# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development, and set the same values in your
# hosting provider's environment settings for production.
#
# Check /api/health after deploying — it reports which of these are missing.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------

# Canonical site origin, no trailing slash.
# Used for canonical URLs, Open Graph tags, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com


# --- Database --------------------------------------------------------------

# PostgreSQL connection string. REQUIRED — leads and all editable content
# (services, team, FAQs, service areas) live here.
#
# Any provider works: Neon, Supabase, Render, Railway, or your own server. On
# serverless hosting use the provider's *pooled* connection string, because
# every instance opens its own connections and the plain one runs out.
#
# The schema is created automatically on first connection.
DATABASE_URL=postgres://user:password@host:5432/database

# Set to 1 only if your provider presents a self-signed certificate. It keeps
# the connection encrypted but stops verifying who is on the other end, so it
# is off unless you have a specific reason.
DATABASE_SSL_NO_VERIFY=

# Separate database used by `npm test`. The content-store tests write rows and
# run the seeder, so they must never point at the live database. Unset, those
# tests skip rather than fail.
TEST_DATABASE_URL=


# --- Photo uploads ---------------------------------------------------------

# Vercel Blob token. Set automatically when you connect a Blob store to the
# project (Vercel -> Storage -> Create -> Blob).
#
# REQUIRED on serverless hosting. Those filesystems are read-only, so without
# this every photo upload fails at the write — the admin panel reports an
# error and no picture ever reaches a customer. When it is set, uploads go to
# object storage and the local path below is ignored.
BLOB_READ_WRITE_TOKEN=

# Fallback for local development and container hosts with a mounted volume,
# used only when BLOB_READ_WRITE_TOKEN is empty. Deliberately NOT inside
# public/ — Next snapshots that directory at build time, so runtime writes
# there are never served in production.
UPLOADS_PATH=.data/uploads


# --- Lead notification -----------------------------------------------------
# Configure at least one channel, or leads are stored with nobody told about
# them. Both can run at once; each is attempted independently.

# Channel 1 — webhook. Anything that accepts a JSON POST: Zapier, Make, n8n, or
# a CRM intake endpoint (ServiceTitan, Housecall Pro, Jobber).
# Payload: { id, receivedAt, name, phone, email, zip, service, serviceSlug,
#            urgency, message, source }
SERVICE_REQUEST_WEBHOOK_URL=

# Channel 2 — email via Resend (https://resend.com). NOTIFY_TO_EMAIL accepts a
# comma-separated list. The sending domain must be verified with Resend first.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
NOTIFY_TO_EMAIL=


# --- Admin API -------------------------------------------------------------

# Bearer token for GET/PATCH /api/admin/leads. Leave empty and those endpoints
# refuse every request, so an unconfigured deploy is closed rather than open.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=


# --- Admin panel -----------------------------------------------------------
# The browser panel at /admin, where services, team, FAQs, areas and leads are
# managed. Generate all three with:  npm run admin:setup
#
# Without ADMIN_PASSWORD_HASH the login form refuses every attempt, so an
# unconfigured deploy is closed rather than open.

ADMIN_USERNAME=admin

# scrypt hash of the password, as `salt:hash`. The password itself is never
# stored. Forgot it? Run `npm run admin:setup` again to set a new one.
ADMIN_PASSWORD_HASH=

# Signs the session cookie. Changing it logs everyone out immediately, which is
# also how you revoke a session you no longer trust.
ADMIN_SESSION_SECRET=


# --- Privacy ---------------------------------------------------------------

# Salt used to hash visitor IP addresses before storing them (raw IPs are never
# written to the database). Set this so hashes stay stable across restarts;
# without it a random per-process salt is used and rate-limit history resets.
# Generate one the same way as ADMIN_API_TOKEN.
IP_HASH_SALT=
